# ===================================================================
# MODELO DE CONFIGURAÇÃO - SALVALUNO
# Copie este ficheiro para 'application.properties' se quiser ajustar o ambiente.
# RA e senha NÃO ficam aqui: eles são informados na tela de cadastro.
# ===================================================================

# Endereço da página de login do portal
portal.url=https://ea.uniceub.br/Sistema/Acesso/Login

# Base de Dados H2 em arquivo local (pasta data/, ignorada pelo Git)
spring.datasource.url=jdbc:h2:file:./data/salvaluno;DB_CLOSE_DELAY=-1
spring.datasource.driverClassName=org.h2.Driver
spring.datasource.username=sa
spring.datasource.password=

# H2 Console (desligado por padrão; a base guarda senha cifrada e hash)
spring.h2.console.enabled=false
spring.h2.console.path=/h2-console

# JPA / Hibernate
spring.jpa.database-platform=org.hibernate.dialect.H2Dialect
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
